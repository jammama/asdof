[Unit]
Description=asdof-emulator save server
After=network.target

[Service]
EnvironmentFile=/etc/asdof-save-server.env
ExecStart=/usr/local/bin/asdof-save-server
Restart=on-failure
User=www-data
Group=www-data
# 세이브 저장 경로 외에는 쓰기 금지 (하드닝)
ProtectSystem=strict
ReadWritePaths=/var/lib/asdof-emulator
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
